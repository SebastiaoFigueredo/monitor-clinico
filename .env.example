# Copie para .env. Tudo é opcional.
# ANTHROPIC_API_KEY=            # habilita /perguntar com Claude (sem ela, devolve o resumo automático)
# ANTHROPIC_MODEL=claude-opus-5-5
# POSE_BACKEND=yolo             # yolo | openpose
# VIDEO_FPS_ANALISE=5
# ALERTA_COOLDOWN_S=600
# --- Azure: transcrição e análise de texto dos áudios de consulta ---
# AZURE_SPEECH_KEY=             # recurso "Speech" (Serviços de IA do Azure)
# AZURE_SPEECH_REGION=brazilsouth
# AZURE_SPEECH_IDIOMA=pt-BR
# AZURE_LANGUAGE_KEY=           # recurso "Language" (Text Analytics)
# AZURE_LANGUAGE_ENDPOINT=https://<seu-recurso>.cognitiveservices.azure.com/
# AZURE_ENTIDADES_SAUDE=1       # Text Analytics for health (sintomas/diagnósticos com negação); 0 desliga
# ALERTA_WEBHOOK_URL=           # POST JSON de cada alerta (Teams/Slack/chamada de enfermagem)
# ECG_DATASET=                  # pasta da base PhysioNet, se não estiver ao lado do projeto
# CARREGAR_DEMO=1               # a API pré-carrega os pacientes fictícios
